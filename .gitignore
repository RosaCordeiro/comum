# PowerBuilder - binários / build / deploy
*.exe
*.dll
pborca.exe
*.pbd
*.pbx
*.zip
Exe/
Export/

# Pastas locais que não entram no Git
Arquivos/
Fonts/
Icons/
WSDL_*/
**/WSDL_*/

# Objetos .sr* soltos (a fonte versionada é .pbg/snapshots/)
*.sra
*.srw
*.sru
*.srd
*.srf
*.srm
*.srs
*.srj
*.srl
*.srn
*.sro
*.srq
*.srt
!.pbg/snapshots/
!.pbg/snapshots/**

# Em Bibliotecas/, versionar só .pbl e .pbt (sem .sr* / subpastas de lixo)
Bibliotecas/**
!Bibliotecas/**/
!Bibliotecas/**/*.pbl
!Bibliotecas/**/*.pbt

# PBL/PBG na raiz do repositório (devem ficar em Bibliotecas/)
/*.pbl
/*.pbg
*.pbg

# Ruído de IDE / Windows
*.usr.opt
Thumbs.db
Desktop.ini

# PBG - ignora temporários e staging, versiona o resto
.pbg/temp/
.pbg/staging/
.pbg/backup/
!.pbg/snapshots/
!.pbg/snapshots/**
!.pbg/manifest.json
!.pbg/config.json
!.pbg/libs.pbt
!.pbg/pbg.log
!.pbg/pbg.*.log

# Logs (exceto os do pbg)
*.log
